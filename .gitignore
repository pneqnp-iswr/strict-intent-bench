# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Secrets / local environment
.env
.env.*
!.env.example

# Tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log

# Markdown docs: ignore by default, keep only public package docs
*.md
!README.md
!report.md
!benchmark/README.md

# Local / draft files
/data/chat.txt
/data/*.backup.jsonl
/data/*backup*
/data/*original*
/data/risky_ambiguity_appendix.jsonl
next_steps.md
openai_community_post.md

# Root duplicates; keep canonical versions in manual/
/blind_judge_protocol.txt
/manual_results_template.csv

# Ignore generated eval runs by default
results/*

# Keep the main published result
!results/holdout-v2-v8-40/
!results/holdout-v2-v8-40/**

# Keep the earlier holdout for comparison
!results/holdout-v1-v7-40/
!results/holdout-v1-v7-40/**
